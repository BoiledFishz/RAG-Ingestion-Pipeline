# These are environment variables; this file is documentation, not auto-loaded.
# Default serving uses the shared full TechQA pipeline. AGENT_COLLECTION and
# AGENT_EMBEDDING_PROVIDER configure only the legacy backend and seed command.
AGENT_RETRIEVAL_BACKEND=techqa
TECHQA_PROFILE=full
TECHQA_COLLECTION=techqa_full_hash
TECHQA_QDRANT_URL=http://localhost:6333
TECHQA_RERANKER=nomic
TECHQA_DENSE_BACKEND=semantic
TECHQA_SEMANTIC_URL=http://127.0.0.1:11435
AGENT_PROFILE=ollama
AGENT_EMBEDDING_PROVIDER=auto
AGENT_COLLECTION=techqa_full_hash
# Relative paths are resolved from this project's folder, never the shell cwd.
# Used only when AGENT_QDRANT_URL is unset; suitable for the smaller core scope.
AGENT_QDRANT_PATH=.agent_data/qdrant
# Recommended for the full 801,998-document corpus.
AGENT_QDRANT_URL=http://127.0.0.1:6333
# AGENT_QDRANT_API_KEY=
AGENT_OLLAMA_URL=http://localhost:11434
AGENT_MODEL=qwen2.5:7b
AGENT_EMBEDDING_MODEL=nomic-embed-text
AGENT_TOP_K=8
AGENT_MAX_CONTEXT_TOKENS=2400
AGENT_MAX_SOURCES=8
AGENT_MIN_RELEVANCE=0.20
AGENT_TOOL_TIMEOUT=30
AGENT_LLM_TIMEOUT=120

# Official IBM TechQA archive (downloaded from PrimeQA/TechQA on Hugging Face).
TECHQA_ARCHIVE=data/techqa/raw/TechQA.tar.gz
TECHQA_EXTRACTED=data/techqa/extracted
TECHQA_SCOPE=full
TECHQA_CHUNK_SIZE=1200
TECHQA_CHUNK_OVERLAP=160
TECHQA_BATCH_SIZE=128
