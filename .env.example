# Local, free model endpoints (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
SUMMARY_PROVIDER=ollama
SUMMARY_MODEL=llama3.2:3b
ANSWER_MODEL=qwen2.5:7b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Pipeline tuning
CHUNK_SIZE=512
CHUNK_OVERLAP=64
REQUEST_CONCURRENCY=8
EMBEDDING_BATCH_SIZE=32
QDRANT_PATH=.rag_data/qdrant
QDRANT_COLLECTION=techqa_nomic_v3
LOG_LEVEL=INFO

# Retrieval and grounded generation
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_RERANK_K=20
RETRIEVAL_FINAL_K=5
RRF_RANK_CONSTANT=60
MAX_CONTEXT_TOKENS=8000
MAX_CHUNKS_PER_DOCUMENT=2
RERANKER_TIMEOUT_SECONDS=5
RERANKER_PROVIDER=lexical
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
RERANKER_LEXICAL_WEIGHT=0.7
RELEVANCE_THRESHOLD=0.05
DENSE_RELEVANCE_THRESHOLD=0.50510450
SPARSE_RELEVANCE_THRESHOLD=0.49267677
HYBRID_RELEVANCE_THRESHOLD=0.49092925
FALLBACK_QUERY_COVERAGE_THRESHOLD=0.12037526

# OCR: install the Tesseract executable separately and adjust when needed.
TESSERACT_CMD=
OCR_LANGUAGES=eng

# Shared official full TechQA retrieval
RAG_BACKEND=techqa
TECHQA_PROFILE=full
TECHQA_RERANKER=nomic
TECHQA_DENSE_BACKEND=semantic
TECHQA_SEMANTIC_URL=http://127.0.0.1:11435
TECHQA_QUERY_DEVICE=cpu
# Hash/Qdrant settings apply only to the explicitly selected historical baseline.
TECHQA_QDRANT_URL=http://localhost:6333
TECHQA_COLLECTION=techqa_full_hash
